# Environment Configuration
ENVIRONMENT=development

# Database Configuration
MYSQL_ROOT_PASSWORD=your_secure_root_password
MYSQL_DATABASE=veriaguide_db
MYSQL_USER=wp_user
MYSQL_PASSWORD=your_secure_db_password
DB_NAME=veriaguide_db
DB_USER=wp_user
DB_PASSWORD=your_secure_db_password
DB_HOST=localhost
DB_PORT=3306

# WordPress Configuration
WP_API_URL=http://wordpress:80/wp-json/wp/v2
WP_API_USERNAME=admin
WP_API_PASSWORD=your_wp_application_password

# Maps (browser key; restrict by HTTP referrer in Google Cloud)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# AI Guide (Gemini). Required on the server if AI_GUIDE_ENABLED=true
GOOGLE_API_KEY=your_gemini_api_key_here
AI_GUIDE_ENABLED=false
AI_GUIDE_MODEL=gemini-3.8-flash
AI_GUIDE_MAX_VENUES=25
AI_GUIDE_MAX_TOKENS=2500
AI_GUIDE_TIMEOUT=45
AI_GUIDE_RATE_LIMIT=5

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_DEFAULT_TTL=1800
CACHE_EXPIRY=3600

# Application
SECRET_KEY=your_very_secure_secret_key_here
ADMIN_API_KEY=your_admin_api_key_here
ALLOWED_HOSTS=localhost,127.0.0.1,veriaguide.gr,www.veriaguide.gr
SITE_URL=https://veriaguide.gr

# Performance
WORKERS=4
HTTP_TIMEOUT=30
WP_API_TIMEOUT=30
HTTP_POOL_CONNECTIONS=10
HTTP_POOL_MAXSIZE=10

# Logging
LOG_LEVEL=INFO

# Ports (local/dev)
WP_PORT=8086
REDIS_PORT=6379
FRONTEND_PORT=8000

# Pagination
ITEMS_PER_PAGE=12

# Optional deploy helpers (local scripts only; not used by docker-compose.vps.yml)
# SSH_HOST=your-ssh-alias
# WP_DOCUMENT_ROOT=/path/to/document/root
# VPS_USER=deploy
# VPS_HOST=YOUR_VPS_HOST
# SSH_PORT=22
