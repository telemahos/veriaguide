# VeriaGuide Production Environment - Traefik Proxy + Docker Containers
ENVIRONMENT=production

# --- MySQL Configuration (for the Docker DB Container) ---
MYSQL_DATABASE=veri_veriaguide_db
MYSQL_USER=veri_wp_kostass
MYSQL_PASSWORD=fai3don4
MYSQL_ROOT_PASSWORD=abc12345

# --- WordPress Configuration (as Container) ---
WP_PORT=8086
SITE_URL=https://veriaguide.gr
WP_API_URL=http://wordpress:80/wp-json/wp/v2

# --- FastAPI Configuration ---
FRONTEND_PORT=8000
DEBUG=False
ALLOWED_HOSTS=veriaguide.gr,www.veriaguide.gr

# --- Redis Configuration (as Container) ---
# The application requires the full URL, not just the port.
REDIS_URL=redis://veriaguide_redis_prod:6379

###################################################################
# IMPORTANT: PLEASE REPLACE THE PLACEHOLDER VALUES BELOW          #
###################################################################

# --- Security ---
# Generate a new, strong secret key for your application.
# Example command: openssl rand -hex 32
SECRET_KEY=your_very_secure_secret_key_change_this_in_production

# --- Google Maps API ---
# Enter your actual Google Maps API Key for production.
GOOGLE_MAPS_API_KEY=your_production_google_maps_api_key


# --- Performance & Logging ---
WORKERS=4
CACHE_EXPIRY=7200
REDIS_DEFAULT_TTL=3600
LOG_LEVEL=INFO